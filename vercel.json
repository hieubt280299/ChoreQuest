{
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://chorequest-32a06.firebaseapp.com/__/auth/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(sw.js|push-sw.js|manifest.webmanifest|version.json)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "crons": [
    { "path": "/api/reminders", "schedule": "0 0 * * *" },
    { "path": "/api/reminders", "schedule": "0 1 * * *" },
    { "path": "/api/reminders", "schedule": "0 2 * * *" },
